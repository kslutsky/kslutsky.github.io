      "policies": {},
      "checkConstraints": {
        "type_check": {
          "name": "type_check",
          "value": "\"articles\".\"type\" IN ('preprint', 'published', 'erratum')"
        },
        "status_check": {
          "name": "status_check",
          "value": "\"articles\".\"status\" IN ('draft', 'published')"
        },
        "erratum_parent_check": {
          "name": "erratum_parent_check",
          "value": "(\"articles\".\"type\" = 'erratum' AND \"articles\".\"parent_id\" IS NOT NULL) OR (\"articles\".\"type\" != 'erratum' AND \"articles\".\"parent_id\" IS NULL)"
        },
        "pdf_source_check": {
          "name": "pdf_source_check",
          "value": "\"articles\".\"pdf_source\" IS NULL OR \"articles\".\"pdf_source\" IN ('arxiv', 'upload', 'external')"
        },
        "pdf_source_arxiv_check": {
          "name": "pdf_source_arxiv_check",
          "value": "\"articles\".\"pdf_source\" != 'arxiv' OR \"articles\".\"arxiv_id\" IS NOT NULL"
        },
        "pdf_source_upload_check": {
          "name": "pdf_source_upload_check",
          "value": "\"articles\".\"pdf_source\" != 'upload' OR \"articles\".\"pdf_url\" IS NOT NULL"
        },
        "pdf_source_external_check": {
          "name": "pdf_source_external_check",
          "value": "\"articles\".\"pdf_source\" != 'external' OR \"articles\".\"pdf_url\" IS NOT NULL"
        },
        "published_year_check": {
          "name": "published_year_check",
          "value": "\"articles\".\"published_year\" IS NULL OR (\"articles\".\"published_year\" >= 1900 AND \"articles\".\"published_year\" <= 2100)"
        },
        "published_month_check": {
          "name": "published_month_check",
          "value": "\"articles\".\"published_month\" IS NULL OR (\"articles\".\"published_month\" >= 1 AND \"articles\".\"published_month\" <= 12)"
        },
        "published_day_check": {
          "name": "published_day_check",
          "value": "\"articles\".\"published_day\" IS NULL OR (\"articles\".\"published_day\" >= 1 AND \"articles\".\"published_day\" <= 31)"
        }
      },
